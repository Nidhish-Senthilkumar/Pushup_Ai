// Sends app.getcadence.cc (the old Cadence task app) and www.getcadence.cc to https://getcadence.cc.
// Deploy (see HANDOFF.md): npx wrangler@4 deploy -c deploy/redirects/wrangler.jsonc
{
  "name": "cadence-fitness-redirects",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "vars": { "CANONICAL": "https://getcadence.cc" },
  "routes": [
    { "pattern": "app.getcadence.cc", "custom_domain": true },
    { "pattern": "www.getcadence.cc", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
